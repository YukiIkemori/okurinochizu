---
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import Referral from '../../components/Referral.astro';
import ArticleList from '../../components/ArticleList.astro';
import RegionLinks from '../../components/RegionLinks.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import { articleVisual, interludeVisual } from '../../data/visuals';
import { articles, regions, articleUrl, articleListTitle, categoryName, site } from '../../data/site';
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props;
const title = articleListTitle(article);
const related = article.related.flatMap(slug => articles.filter(a => a.slug === slug));
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: title, description: article.description, datePublished: article.publishedAt, dateModified: article.updatedAt, inLanguage: 'ja', articleSection: categoryName(article.category), keywords: article.keywords.join(', '), mainEntityOfPage: site.url + articleUrl(article.slug), publisher: { '@type': 'Organization', name: site.name, url: site.url, logo: { '@type': 'ImageObject', url: site.url + '/apple-touch-icon.png' } }, image: site.url + '/og-image.png' },
  ...(article.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: article.faq.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) }] : []),
];
---
<Base title={article.title} description={article.description} breadcrumbs={[{ name: '記事一覧', url: '/guides/' }, { name: title }]} schema={schema}>
  <article class="wrap article-shell">
    <header class="article-head"><h1>{title}</h1><p class="article-lead">{article.lead}</p><EditorialImage kind={articleVisual(article.category)} /></header>
    <div class="article-body">
      <Sections sections={article.sections} interlude={article.sections.length >= 4 ? interludeVisual(article.category) : undefined} />
      {article.faq.length > 0 && <section class="faq" id="questions"><h2>よくある疑問</h2>{article.faq.map(faq => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</section>}
      {related.length > 0 && <section class="related-articles"><header class="directory-heading"><h2>関連記事</h2><a class="text-link" href="/guides/">記事一覧</a></header><ArticleList items={related} /></section>}
      <section class="related-articles"><header class="directory-heading"><h2>地域の案内</h2></header><RegionLinks items={regions.filter(r => article.regions.length === 0 || article.regions.includes(r.slug))} /></section>
      <Referral referral={article.referral} slug={article.slug} intent={article.category} region={article.regions.length === 1 ? article.regions[0] : 'all'} />
    </div>
  </article>
</Base>
