---
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import Sources from '../../components/Sources.astro';
import Referral from '../../components/Referral.astro';
import ArticleList from '../../components/ArticleList.astro';
import { articles, regions, sources, articleUrl, regionUrl, categoryName, site } from '../../data/site';
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props;
const related = article.related.flatMap(slug => articles.filter(a => a.slug === slug));
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: article.title, description: article.description, datePublished: article.publishedAt, dateModified: article.updatedAt, inLanguage: 'ja', articleSection: categoryName(article.category), keywords: article.keywords.join(', '), citation: sources.filter(source => article.sources.includes(source.id)).map(source => source.url), mainEntityOfPage: site.url + articleUrl(article.slug), author: { '@type': 'Organization', name: 'おくりの地図編集部', url: site.url + '/about/' }, publisher: { '@type': 'Organization', name: site.name, url: site.url, logo: { '@type': 'ImageObject', url: site.url + '/apple-touch-icon.png' } }, image: site.url + '/og-image.png' },
  ...(article.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: article.faq.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) }] : []),
];
---
<Base title={article.title} description={article.description} breadcrumbs={[{ name: '知っておきたいこと', url: '/guides/' }, { name: categoryName(article.category), url: '/topics/' + article.category + '/' }, { name: article.title }]} schema={schema}>
  <article class="wrap article-shell">
    <header class="article-head"><p class="eyebrow">{categoryName(article.category)}</p><h1>{article.title}</h1><div class="article-meta"><span>おくりの地図編集部</span><span>公開：<time datetime={article.publishedAt}>{article.publishedAt.replaceAll('-', '.')}</time></span><span>更新：<time datetime={article.updatedAt}>{article.updatedAt.replaceAll('-', '.')}</time></span></div><p class="article-lead">{article.lead}</p></header>
    <div class="article-body">
      <div class="answer"><p class="eyebrow">まず、知っておきたいこと</p><p>{article.answer}</p></div>
      {article.category === 'urgent' && <p class="urgent-article-link"><a class="text-link" href="https://so-gi.com/call?utm_source=okurinochizu&amp;utm_medium=referral&amp;utm_campaign=reader-guide&amp;utm_content=urgent-article-intro" data-provider-link data-content-slug={article.slug} data-intent="urgent" data-placement="urgent-article-intro">医療側の確認後、つばさの搬送窓口を確認 <span aria-hidden="true">↗</span></a></p>}
      <details class="toc-mobile"><summary>この記事でわかること</summary><ol>{article.sections.map(s => <li><a href={'#' + s.id}>{s.heading}</a></li>)}</ol></details>
      <Sections sections={article.sections} />
      {article.faq.length > 0 && <section class="faq" id="questions"><h2>よくある疑問</h2>{article.faq.map(faq => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</section>}
      <Sources ids={article.sources} slug={article.slug} region={article.regions.length === 1 ? article.regions[0] : 'all'} />
      <Referral referral={article.referral} slug={article.slug} intent={article.category} region={article.regions.length === 1 ? article.regions[0] : 'all'} />
      {related.length > 0 && <section class="related-articles"><h2>続けて読みたいこと</h2><ArticleList items={related} /></section>}
      <section class="related-articles"><h2>お住まいの地域の案内</h2><nav class="topic-navigation" aria-label="地域別の案内">{regions.filter(r => article.regions.length === 0 || article.regions.includes(r.slug)).map(r => <a href={regionUrl(r.slug)}>{r.name}</a>)}</nav></section>
      <p class="reading-note">この記事は一般的な情報を整理したもので、個別の契約・給付・法的判断を確約するものではありません。ご自身の状況は担当窓口でお確かめください。</p>
    </div>
    <aside class="toc"><p>この記事でわかること</p><ol>{article.sections.map(s => <li><a href={'#' + s.id}>{s.heading}</a></li>)}{article.faq.length > 0 && <li><a href="#questions">よくある疑問</a></li>}<li><a href="#sources-heading">出典・公式情報</a></li></ol></aside>
  </article>
</Base>
