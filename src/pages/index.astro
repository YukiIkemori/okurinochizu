---
import Base from '../layouts/Base.astro';
import RegionMap from '../components/RegionMap.astro';
import ArticleList from '../components/ArticleList.astro';
import Referral from '../components/Referral.astro';
import { site, articles, categories } from '../data/site';
const essentials = ['hospital-transport', 'funeral-cost', 'family-funeral', 'tree-burial'];
const picked = essentials.flatMap(slug => articles.filter(a => a.slug === slug));
---
<Base title={site.name}>
  <section class="hero wrap">
    <h1>大切な人をおくる、<br />その前に。</h1>
    <RegionMap />
    <a class="text-link" href="/regions/">地域から探す</a>
  </section>
  <section class="home-section wrap">
    <h2>記事を読む</h2>
    <nav class="topic-navigation" aria-label="記事のカテゴリー">{categories.map(category => <a href={'/topics/' + category.slug + '/'}>{category.name}</a>)}</nav>
    <ArticleList items={picked} />
    <a class="text-link" href="/guides/">すべての記事を読む</a>
    <Referral referral={{ href: 'https://so-gi.com/hall', label: 'つばさ公益社', note: '葬儀についての相談は、つばさ公益社へ。' }} slug="home" placement="home-end" intent="regional-funeral" />
  </section>
</Base>
