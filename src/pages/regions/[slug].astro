---
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import Referral from '../../components/Referral.astro';
import SourceNote from '../../components/SourceNote.astro';
import ArticleList from '../../components/ArticleList.astro';
import RegionLinks from '../../components/RegionLinks.astro';
import RegionMap from '../../components/RegionMap.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import ArticleHeading from '../../components/ArticleHeading.astro';
import KeyPoints from '../../components/KeyPoints.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import Toc from '../../components/Toc.astro';
import { regionVisual } from '../../data/visuals';
import { regions, articles, regionUrl, site } from '../../data/site';
export function getStaticPaths() { return regions.map(region => ({ params: { slug: region.slug }, props: { region } })); }
const { region } = Astro.props;
const related = region.related.flatMap(slug => articles.filter(a => a.slug === slug));
const title = region.pageTitle;
const keyPoints = region.keyPoints?.length ? region.keyPoints : undefined;
const referral = { referral: region.referral, slug: region.slug, region: region.slug, intent: 'regional-funeral' };
const toc = region.sections.map(({ id, heading }) => ({ id, heading }));
const schema = [{ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description: region.description, dateModified: region.updatedAt, inLanguage: 'ja', url: site.url + regionUrl(region.slug), about: { '@type': 'AdministrativeArea', name: region.prefecture + region.name } }];
---
<Base title={title} description={region.description} breadcrumbs={[{ name: '地域の案内', url: '/regions/' }, { name: region.name }]} schema={schema}>
  <article class="wrap article-shell">
    <header class="article-head"><ArticleHeading title={region.heading} /></header>
    <aside class="article-side"><Toc items={toc} variant="side" /></aside>
    <div class="article-body">
      {keyPoints ? <KeyPoints points={keyPoints} /> : <p class="article-lead">{region.lead}</p>}
      <Referral {...referral} variant="top" />
      {region.quickFacts?.length ? <QuickFacts facts={region.quickFacts} /> : null}
      <Toc items={toc} variant="inline" />
      <EditorialImage kind={regionVisual(region.slug)} />
      <Sections sections={region.sections} />
      <Referral {...referral} />
      <SourceNote ids={region.sources} />
      <section class="related-articles"><header class="directory-heading"><h2>関連記事</h2><a class="text-link" href="/guides/">記事一覧</a></header><ArticleList items={related} /></section>
      <section class="related-articles other-regions"><header class="directory-heading"><h2>ほかの地域</h2></header><div class="region-finder"><RegionLinks items={regions.filter(r => r.slug !== region.slug)} /><RegionMap current={region.slug} /></div></section>
    </div>
  </article>
</Base>
