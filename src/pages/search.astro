---
import Base from '../layouts/Base.astro';
import { articles, regions, categories, articleUrl, regionUrl, categoryName } from '../data/site';
const entries = [
  ...articles.map(a => ({ title: a.title, description: a.description, url: articleUrl(a.slug), category: a.category, regions: a.regions, label: categoryName(a.category), text: [a.title, a.description, a.answer, ...a.keywords, ...a.sections.flatMap(s => [s.heading, ...s.paragraphs, ...(s.bullets || [])])].join(' ') })),
  ...regions.map(r => ({ title: r.name + 'の葬儀・家族葬・お墓案内', description: r.description, url: regionUrl(r.slug), category: 'region', regions: [r.slug], label: r.prefecture + ' ／ 地域の案内', text: [r.name, r.description, r.focus, ...r.sections.flatMap(s => [s.heading, ...s.paragraphs])].join(' ') })),
];
---
<Base title="記事を探す" description="家族葬、葬儀費用、搬送、樹木葬、互助会。キーワード、地域、テーマから記事を探せます。" noindex breadcrumbs={[{ name: '記事を探す' }]}>
  <div class="wrap"><header class="page-intro"><p class="eyebrow">記事を探す</p><h1>知りたいことを、<br />言葉から。</h1><p class="lead">「家族葬」「樹木葬」「見積もり」など、気になる言葉で検索できます。</p></header>
    <section class="index-section">
      <form class="search-form" id="search-form" action="/search/" method="get" role="search">
        <div><label for="query">キーワード</label><input id="query" type="search" name="q" autocomplete="off" maxlength="100" placeholder="家族葬、費用、搬送など" /></div>
        <div><label for="region">地域</label><select id="region" name="region"><option value="">すべての地域</option>{regions.map(r => <option value={r.slug}>{r.name}</option>)}</select></div>
        <div><label for="topic">テーマ</label><select id="topic" name="topic"><option value="">すべてのテーマ</option><option value="region">地域の案内</option>{categories.map(c => <option value={c.slug}>{c.name}</option>)}</select></div>
        <button type="submit" class="primary-button">記事を探す</button>
      </form>
      <noscript><p>検索での絞り込みにはJavaScriptが必要です。以下の記事一覧、または<a href="/regions/">地域別の案内</a>からお選びください。</p></noscript>
      <p class="search-count" id="search-count" role="status" aria-live="polite">{entries.length}件の記事・地域案内</p>
      <ol class="article-list" id="search-results">{entries.map(entry => <li data-search-entry data-search-text={entry.text} data-search-category={entry.category} data-search-regions={entry.regions.join(',')}><div><p class="eyebrow">{entry.label}</p><h3><a href={entry.url}>{entry.title}<span class="arrow" aria-hidden="true">↗</span></a></h3><p class="article-summary">{entry.description}</p></div></li>)}</ol>
      <div id="search-empty" class="search-empty" hidden><p>該当する記事が見つかりませんでした。<br />言葉を短くするか、地域・テーマの絞り込みを解除してお試しください。</p><a href="/guides/">すべての記事を見る</a></div>
    </section>
  </div>
  <script>
    const form = document.querySelector<HTMLFormElement>('#search-form');
    const query = document.querySelector<HTMLInputElement>('#query');
    const region = document.querySelector<HTMLSelectElement>('#region');
    const topic = document.querySelector<HTMLSelectElement>('#topic');
    const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-search-entry]'));
    const count = document.querySelector<HTMLElement>('#search-count');
    const empty = document.querySelector<HTMLElement>('#search-empty');
    const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('ja').trim();
    const initial = new URLSearchParams(location.search);
    if (query) query.value = (initial.get('q') || '').slice(0, 100);
    if (region && Array.from(region.options).some(o => o.value === initial.get('region'))) region.value = initial.get('region') || '';
    if (topic && Array.from(topic.options).some(o => o.value === initial.get('topic'))) topic.value = initial.get('topic') || '';
    function filter(updateUrl = false) {
      const terms = normalize(query?.value || '').split(/\s+/).filter(Boolean);
      const area = region?.value || '';
      const category = topic?.value || '';
      let matches = 0;
      entries.forEach(entry => {
        const text = normalize(entry.dataset.searchText || '');
        const areas = (entry.dataset.searchRegions || '').split(',').filter(Boolean);
        const found = terms.every(term => text.includes(term)) && (!area || !areas.length || areas.includes(area)) && (!category || entry.dataset.searchCategory === category);
        entry.hidden = !found;
        if (found) matches++;
      });
      if (count) count.textContent = matches + '件の記事・地域案内';
      if (empty) empty.hidden = matches > 0;
      if (updateUrl) {
        const params = new URLSearchParams();
        if (query?.value.trim()) params.set('q', query.value.trim());
        if (area) params.set('region', area);
        if (category) params.set('topic', category);
        history.replaceState(null, '', '/search/' + (params.size ? '?' + params.toString() : ''));
      }
    }
    form?.addEventListener('submit', event => { event.preventDefault(); filter(true); count?.scrollIntoView({ block: 'nearest' }); });
    filter();
  </script>
</Base>
