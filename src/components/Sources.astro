---
import { sources } from '../data/site';
interface Props { ids: string[]; slug?: string; region?: string; }
const { ids, slug, region = 'all' } = Astro.props;
const selected = ids.map(id => {
  const source = sources.find(s => s.id === id);
  if (!source) throw new Error('Unknown source: ' + id);
  return source;
});
---
<section class="sources" aria-labelledby="sources-heading">
  <h2 id="sources-heading">出典・確認した公式情報</h2>
  <ol>{selected.map(source => <li>
    <a href={source.url} rel="noopener" data-provider-link={['so-gi.com', 'www.so-gi.com'].includes(new URL(source.url).hostname) ? '' : undefined} data-content-slug={slug} data-region={region} data-placement="source" data-intent="source">{source.title}<span aria-hidden="true"> ↗</span></a>
    <small>確認日：{source.checkedAt.replaceAll('-', '.')}</small>
    {source.note && <p>{source.note}</p>}
  </li>)}</ol>
  <p>費用・給付要件・受付方法は変更されることがあります。申込みや申請の前に、リンク先の最新情報と担当窓口をご確認ください。</p>
</section>
