---
// `current` marks the municipality whose page shows the map.
interface Props { current?: string; }
const { current } = Astro.props;
const places = [
  { slug: 'ueda', name: '上田市', cx: 91, cy: 162, x: 48, y: 146 },
  { slug: 'tomi', name: '東御市', cx: 130, cy: 184, x: 122, y: 190, end: true },
  { slug: 'komoro', name: '小諸市', cx: 177, cy: 182, x: 132, y: 165 },
  { slug: 'miyota', name: '御代田町', cx: 238, cy: 165, x: 215, y: 147 },
  { slug: 'karuizawa', name: '軽井沢町', cx: 286, cy: 181, x: 278, y: 210 },
  { slug: 'saku', name: '佐久市', cx: 214, cy: 245, x: 212, y: 275 },
  { slug: 'sakuho', name: '佐久穂町', cx: 232, cy: 300, x: 242, y: 306 },
  { slug: 'koumi', name: '小海町', cx: 224, cy: 328, x: 214, y: 334, end: true },
  { slug: 'tateshina', name: '立科町', cx: 115, cy: 233, x: 78, y: 219 },
  { slug: 'nagawa', name: '長和町', cx: 104, cy: 266, x: 96, y: 272, end: true },
  { slug: 'annaka', name: '安中市', cx: 373, cy: 198, x: 373, y: 180 },
  { slug: 'tomioka', name: '富岡市', cx: 376, cy: 256, x: 375, y: 284 },
] as { slug: string; name: string; cx: number; cy: number; x: number; y: number; end?: boolean }[];
---
<figure class="map-figure">
  <svg viewBox="0 0 480 420" role="group" aria-labelledby="map-title map-description">
    <title id="map-title">長野県東信と群馬県西毛の12地域</title>
    <desc id="map-description">上田市、東御市、小諸市、佐久市、佐久穂町、小海町、立科町、長和町、御代田町、軽井沢町、安中市、富岡市。各地域の名前から案内ページへ移動できます。模式図のため距離や境界は正確ではありません。</desc>
    <defs><pattern id="map-lines" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(30)"><line x1="0" y1="0" x2="0" y2="10" stroke="#d9dece" stroke-width=".6"/></pattern></defs>
    <path d="M47 143 88 111 99 63 143 54 160 90 206 99 222 82 260 91 275 126 310 139 304 185 284 218 302 250 271 274 255 309 214 344 177 333 158 348 120 315 94 273 55 255 35 211Z" fill="#e7eadc" stroke="#d0d7c3" stroke-width="1"/>
    <path d="m310 139 24-36 48-5 46 21 23 49-10 42 12 34-28 45-50 23-52-20-21-42-18-32 20-33Z" fill="url(#map-lines)" stroke="#d0d7c3" stroke-width="1"/>
    <path d="M90 178c46 16 76-6 112-3 36 3 40 37 39 64-1 29-24 55-25 85" stroke="#b4c7c0" stroke-width="2" fill="none"/>
    <path d="M246 82c-14 17-34 45-42 73M216 157c21-9 37-4 56 12" stroke="#c5ccb9" stroke-width="1" fill="none" stroke-dasharray="3 5"/>
    <path d="m230 117 11-16 11 16m6 1 11-17 11 17m-50 5 7-11 7 11" fill="none" stroke="#abb69f" stroke-width="1"/>
    <text x="257" y="87" font-size="9" fill="#748169" letter-spacing="2">浅間山</text>
    <text class="map-label" x="83" y="289">長野県</text><text class="map-label" x="352" y="143">群馬県</text>
    {places.map(place => <a class={'map-region' + (place.slug === current ? ' map-region--current' : '')} href={'/regions/' + place.slug + '/'} aria-label={place.name + 'の案内'} aria-current={place.slug === current ? 'page' : undefined}><circle cx={place.cx} cy={place.cy} r={place.slug === current ? 6 : 4}/><text x={place.x} y={place.y} text-anchor={place.end ? 'end' : undefined}>{place.name}</text></a>)}
    <path d="M414 55V29m-5 10 5-10 5 10" fill="none" stroke="#6f7a67" stroke-width="1"/><text x="409" y="20" font-size="10" fill="#6f7a67">N</text>
    <path d="M72 355c32 18 64 23 97 21" fill="none" stroke="#bcc7b3" stroke-width="1"/>
  </svg>
</figure>
