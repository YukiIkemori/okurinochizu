---
import type { Article } from '../data/types';
import { articleUrl, articleListTitle } from '../data/site';
interface Props { items: Article[]; headingLevel?: 2 | 3; }
const { items, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---
<ol class="article-list">
  {items.map(item => (
    <li>
      <Heading><a href={articleUrl(item.slug)}>{articleListTitle(item)}</a></Heading>
      <p class="article-summary">{item.description}</p>
    </li>
  ))}
</ol>
