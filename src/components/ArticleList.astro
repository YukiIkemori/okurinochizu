---
import type { Article } from '../data/types';
import { articleUrl, categoryName } from '../data/site';
interface Props { items: Article[]; numbered?: boolean; }
const { items, numbered = false } = Astro.props;
---
<ol class:list={['article-list', { numbered }]}>
  {items.map((item, index) => (
    <li>
      {numbered && <span class="list-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
      <div>
        <p class="eyebrow">{categoryName(item.category)}</p>
        <h3><a href={articleUrl(item.slug)}>{item.title}<span class="arrow" aria-hidden="true">↗</span></a></h3>
        <p class="article-summary">{item.description}</p>
      </div>
    </li>
  ))}
</ol>
