---
import { Image } from 'astro:assets';
import { getEditorialImage, editorialPosition, type EditorialKind } from '../data/visuals';
// hero: the home page. band: the short strip under a collection page's title. header: the one image of
// an article or region page, shown after the summary, so it loads lazily.
interface Props {
  kind: EditorialKind;
  variant?: 'hero' | 'band' | 'header';
}
const { kind, variant = 'header' } = Astro.props;
const sizes = variant === 'hero'
  ? '(min-width: 1184px) 544px, (min-width: 761px) 48vw, calc(100vw - 40px)'
  : variant === 'band' ? '(min-width: 1184px) 1120px, calc(100vw - 40px)'
  : '(min-width: 800px) 720px, calc(100vw - 40px)';
---
<picture class={'editorial-image editorial-image--' + variant}>
  <Image src={getEditorialImage(kind)} alt="" width={1536} widths={[480, 800, 1200, 1536]} sizes={sizes} format="webp" quality={78} loading={variant === 'header' ? 'lazy' : 'eager'} decoding="async" fetchpriority={variant === 'hero' ? 'high' : 'auto'} style={'object-position:' + editorialPosition(kind)} />
</picture>
