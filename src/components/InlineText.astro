---
import type { InlineLink } from '../data/types';
interface Props { text: string; links?: InlineLink[]; }
const { text, links = [] } = Astro.props;
const positions = links.map(link => {
  const start = text.indexOf(link.text);
  if (!link.text || start < 0 || text.indexOf(link.text, start + link.text.length) !== -1) {
    throw new Error(`Inline link must match one phrase: ${link.text}`);
  }
  return { ...link, start, end: start + link.text.length };
}).sort((a, b) => a.start - b.start);
const parts: { text: string; href?: string }[] = [];
let cursor = 0;
for (const link of positions) {
  if (link.start < cursor) throw new Error('Inline links cannot overlap.');
  if (link.start > cursor) parts.push({ text: text.slice(cursor, link.start) });
  parts.push({ text: link.text, href: link.href });
  cursor = link.end;
}
if (cursor < text.length) parts.push({ text: text.slice(cursor) });
---
{parts.map(part => part.href ? <a href={part.href}>{part.text}</a> : part.text)}
